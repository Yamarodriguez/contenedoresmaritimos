---
import Base from '../layouts/Base.astro';
import Contenido from '../components/Contenido.astro';
import Hero from '../components/Hero.astro';
import { armarPagina } from '../lib/pagina';
import { limpiar } from '../lib/html';
import { seoDe } from '../lib/seo';
import { textoLegal } from '../lib/legales';
import { migasDe } from '../lib/migas';
import { extrasCiudad } from '../lib/ciudades';
import { alternosDe } from '../lib/rutas';
import faqPaginas from '../data/faq-paginas.json';

export async function getStaticPaths() {
  const files = import.meta.glob('../content/pages/*.json', { eager: true });
  return Object.entries(files)
    .map(([path, mod]: [string, any]) => mod.default)
    .filter((data: any) => data.slug !== 'contenedores-maritimos') // esa es la home, va por index.astro
    .map((data: any) => ({
      params: { slug: new URL(data.url).pathname.replace(/^\/|\/$/g, '') }, // /ar/salta/ → ar/salta
      props: { data },
    }));
}

const { data } = Astro.props as { data: any };
const seo = seoDe(data.slug);
const legal = data.blocks.length === 0 ? textoLegal(data.slug) : null;
const bloques = legal ? [{ type: 'text', html: legal, nuevo: true }] : data.blocks;
const pagina = armarPagina(bloques, { slug: data.slug, ficha: data.ar_de, pais: data.menu === 'argentina' ? 'ar' : 'es', servicios: !data.servicio && data.slug !== 'servicios-contenedores-maritimos' && !legal });
const faqLista = data.faq ?? ((faqPaginas as Record<string, any>)[data.ar_de ?? data.slug]?.faq ?? []).map(([pregunta, respuesta]: string[]) => ({ pregunta, respuesta }));
const datos = faqLista.length ? [{ '@type': 'FAQPage', mainEntity: faqLista.map((f: any) => ({ '@type': 'Question', name: f.pregunta, acceptedAnswer: { '@type': 'Answer', text: f.respuesta } })) }] : [];
const h1 = data.blocks.find((b: any) => b.type === 'heading' && b.tag === 'h1');
// En las páginas nuevas el título de Google es largo: la miga usa el H1.
// Páginas con versión de España y de Argentina (portada, precios, segunda mano): hreflang entre las dos.
const alternos = alternosDe(data.slug);
const migas = migasDe(data, data.nueva && h1 ? h1.text.replace(/<[^>]+>/g, '') : data.title);
---
<Base
  title={seo.titulo || data.title}
  description={seo.descripcion || data.meta_description}
  canonical={data.url}
  menu={data.menu}
  imagen={seo.imagen}
  ogTitulo={seo.ogTitulo}
  ogDescripcion={seo.ogDescripcion}
  datos={datos}
  migas={migas}
  pais={data.menu === 'argentina' ? 'ar' : 'es'}
  alternos={alternos}
>
  <Hero titulo={h1 ? h1.text : data.title} hero={pagina.hero} menu={data.menu} zona={extrasCiudad(data.slug)?.etiqueta} />
  <div class="bloque">
    <div class="bloque-in">
      {bloques.length === 0 && (
        <p><em>Esta página aún no tiene contenido capturado (pendiente de copiarlo a mano — ver legales-vivos.json).</em></p>
      )}
      <Contenido pagina={pagina} />
    </div>
  </div>
</Base>
