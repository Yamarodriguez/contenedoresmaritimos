---
import Base from '../layouts/Base.astro';
import { limpiar } from '../lib/html';
import Contenido from '../components/Contenido.astro';
import data from '../content/pages/contenedores-maritimos.json';

const h1 = data.blocks.find((b: any) => b.type === 'heading' && b.tag === 'h1');
---
<Base
  title={data.title}
  description={data.meta_description}
  canonical={data.url}
  menu={data.menu}
>
  <section class="heroe">
    <div class="caja">
      <h1 set:html={limpiar(h1 ? h1.text : data.title)} />
    </div>
  </section>
  <div class="bloque">
    <div class="bloque-in">
      <Contenido blocks={data.blocks} />
    </div>
  </div>
</Base>
