---
// Franja final de presupuesto y pie de página en columnas. Todo sale de los
// menús y de site.json: lo que falte (teléfono, WhatsApp) no se pinta.
import menusData from '../data/menus.json';
import serviciosData from '../data/servicios-paginas.json';
import site from '../data/site.json';
import { paraPais } from '../lib/rutas';

interface Props {
  menu?: string;
}
const { menu = 'contenedores-maritimos' } = Astro.props as Props;
const menus = menusData as Record<string, any[]>;
const items = menus[menu] ?? [];
const legales = menus.politicas ?? [];
const enlace = (etiqueta: string) => items.find((i) => i.label === etiqueta);
const grupo = (etiquetas: string[]) => etiquetas.map(enlace).filter(Boolean);
const pais = menu === 'argentina' ? 'ar' : 'es';
const lugares = (enlace('Provincias')?.children ?? []).slice(0, 7);
const year = new Date().getFullYear();
const correo = site.correo;
---
<section class="cierre">
  <div class="caja cierre-in">
    <div>
      <p class="etiqueta">Presupuesto sin compromiso</p>
      <h2>¿Necesitas un contenedor?</h2>
      <p>Cuéntanos qué contenedor buscas y dónde lo necesitas.</p>
      <p class="heroe-botones">
        <a class="boton" href={paraPais('/contacto/', pais)}>Pide presupuesto</a>
        {correo && <a class="boton boton--borde" href={`mailto:${correo}`}>Escribir un correo</a>}
      </p>
    </div>
    <dl class="heroe-datos cierre-datos">
      <div><dt>Servicios</dt><dd>Venta · alquiler · transporte · construcciones</dd></div>
      <div><dt>Estado</dt><dd>Nuevos y de segunda mano</dd></div>
      <div><dt>Dónde</dt><dd>España y Argentina</dd></div>
    </dl>
  </div>
</section>
<footer class="pie">
  <div class="caja pie-cols">
    <div class="pie-marca">
      <a href={paraPais('/', pais)} class="marca-pie" aria-label={site.nombre}>
        <img src="/img/2022/01/Contenedores-maritimos-.svg" alt="" width="96" height="96" />
        <span class="marca"><b>Contenedores</b><i>Marítimos</i></span>
      </a>
      <p>{site.descripcion}</p>
      {correo && <p><a href={`mailto:${correo}`}>{correo}</a></p>}
      {site.telefono && <p>Teléfono: {site.telefono}</p>}
    </div>
    <nav aria-label="Contenedores">
      <h3>Contenedores</h3>
      <ul>
        {grupo(['Tipos', 'Precios', 'Medidas', 'Segunda mano', 'Venta']).map((i: any) => <li><a href={i.url}>{i.label}</a></li>)}
        <li><a href="/contenedores-para-almacenaje/">Para almacenaje</a></li>
        <li><a href="/contenedores-para-construccion/">Para construcción y obras</a></li>
        <li><a href="/guias/">Guías de compra</a></li>
      </ul>
    </nav>
    <nav aria-label="Servicios">
      <h3>Servicios</h3>
      <ul>
        {grupo(['Construcciones', 'Comprar', 'Transporte', 'Alquiler']).map((i: any) => <li><a href={i.url}>{i.label}</a></li>)}
        <li><a href={paraPais('/servicios-contenedores-maritimos/', pais)}>Todos los servicios</a></li>
        {serviciosData.servicios.map((s: any) => <li><a href={`/${s.slug}/`}>{s.nombre}</a></li>)}
      </ul>
    </nav>
    <nav aria-label="Dónde">
      <h3>Dónde</h3>
      <ul>
        <li><a href="/">España</a></li>
        <li><a href="/ar/">Argentina</a></li>
        <li><a href="/ubicaciones/">Todas las ubicaciones</a></li>
        {lugares.map((i: any) => <li><a href={i.url}>{i.label.replace(/^Contenedores (Mar[ií]timos )?/i, '')}</a></li>)}
      </ul>
    </nav>
    <nav aria-label="Contacto">
      <h3>Contacto</h3>
      <ul>
        <li><a href={paraPais('/contacto/', pais)}>Pedir presupuesto</a></li>
        {correo && <li><a href={`mailto:${correo}`}>Escribir un correo</a></li>}
      </ul>
    </nav>
  </div>
  <div class="caja pie-base">
    <p>© {year} {site.nombre}. Todos los derechos reservados.</p>
    <ul class="pie-legales">
      {legales.map((item: any) => <li><a href={item.url}>{item.label}</a></li>)}
    </ul>
  </div>
</footer>
