---
import Bloque from './Bloque.astro';
import { agrupar } from '../lib/agrupar';
import { conFotosDeSeccion } from '../lib/fotos';

interface Props {
  blocks: any[];
}
const { blocks } = Astro.props as Props;
// El H1 va en el héroe; el resto, en su orden.
const trozos = agrupar(conFotosDeSeccion(blocks.filter((b: any) => !(b.type === 'heading' && b.tag === 'h1'))));
---
{trozos.map((t) => (
  t.tipo === 'consulta' ? (
    <section class="consulta">
      <div class="consulta-texto"><Bloque block={t.titular} /><Bloque block={t.texto} /></div>
      <div class="consulta-form"><Bloque block={t.formulario} /></div>
    </section>
  ) : t.tipo === 'banda' ? (
    <section class="banda">
      <div class="banda-titulo"><Bloque block={t.titular} /></div>
      <div class="banda-foto"><Bloque block={t.imagen} sizes="(max-width: 700px) 90vw, 520px" /></div>
    </section>
  ) : t.tipo === 'rejilla' ? (
    <div class="rejilla">
      {t.tarjetas.map((c) => (
        <article class="tarjeta">
          <Bloque block={c.titular} />
          <Bloque block={c.imagen} sizes="(max-width: 700px) 45vw, 230px" />
        </article>
      ))}
    </div>
  ) : (
    <Bloque block={t.bloque} />
  )
))}
