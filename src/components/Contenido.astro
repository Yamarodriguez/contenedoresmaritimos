---
import Bloque from './Bloque.astro';
import type { Pagina } from '../lib/pagina';
import tiposNuevos from '../data/tipos-nuevos.json';

interface Props {
  pagina: Pagina;
}
const { pagina } = Astro.props as Props;
let n = 0; // las secciones con título alternan panel oscuro y claro
---
<div class={`pagina${pagina.conLateral ? ' con-lateral' : ''}`}>
  {pagina.elementos.map((e) => {
    if (e.tipo === 'consulta') return (
      <aside class="consulta">
        <Bloque block={e.titular} />
        <Bloque block={e.texto} />
        <Bloque block={e.formulario} />
      </aside>
    );
    const clase = e.titular ? (n++ % 2 === 0 ? 'seccion' : 'seccion seccion--clara') : 'seccion seccion--sin-titulo seccion--clara';
    return (
      <section class={clase}>
        {e.titular && (
          <header class="seccion-cab">
            <Bloque block={e.titular} />
            {e.imagen && <div class="seccion-foto"><Bloque block={e.imagen} sizes="(max-width: 700px) 90vw, 440px" /></div>}
          </header>
        )}
        <div class="seccion-cuerpo">
          {e.cuerpo.map((t) => (
            t.tipo === 'rejilla' ? (
              <div class="rejilla">
                {[...t.tarjetas, ...(t.tarjetas.some((c) => /de-20-pies|20 pies/.test((c.titular.href || '') + (c.titular.text || ''))) ? tiposNuevos.tipos.map((n) => ({ titular: { type: 'heading', tag: 'h3', text: n.nombre, href: `/${n.slug}/` }, imagen: { type: 'image', src: `/img/tipos/${n.slug}.svg`, alt: n.nombre, href: `/${n.slug}/` } })) : [])].map((c) => (
                  <article class="tarjeta">
                    <Bloque block={c.titular} />
                    <Bloque block={c.imagen} sizes="(max-width: 700px) 45vw, 230px" />
                  </article>
                ))}
              </div>
            ) : (
              <Bloque block={t.bloque} />
            )
          ))}
        </div>
      </section>
    );
  })}
</div>
