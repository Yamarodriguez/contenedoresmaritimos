---
import Formulario from './Formulario.astro';

interface Block {
  type: string;
  tag?: string;
  text?: string;
  href?: string;
  src?: string;
  alt?: string;
  address?: string;
}

interface Props {
  block: Block;
}
const { block } = Astro.props as Props;

// Las cabeceras de Elementor a veces vienen marcadas como "p" en vez de un
// hN real (lo decidió así el redactor en su momento); se pinta como tal,
// no se reinterpreta.
const Tag = block.tag && /^h[1-6]$/.test(block.tag) ? block.tag : 'p';
---
{block.type === 'heading' && (
  <Tag>{block.text}</Tag>
)}
{block.type === 'text' && (
  <p>{block.text}</p>
)}
{block.type === 'button' && (
  <a class="boton" href={block.href || '#'}>{block.text}</a>
)}
{block.type === 'image' && (
  <img src={block.src} alt={block.alt || ''} loading="lazy" width="800" height="600" />
)}
{block.type === 'map' && (
  <p class="mapa-nota">[Mapa: {block.address || 'ubicación'} — pendiente de conectar Google Maps en la Fase 2]</p>
)}
{block.type === 'contact_form' && (
  <Formulario />
)}
