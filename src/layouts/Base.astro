---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import site from '../data/site.json';
import '../styles/global.css';
import '@fontsource/sora/latin-400.css';
import '@fontsource/sora/latin-700.css';
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-600.css';

interface Props {
  title: string;
  description?: string;
  canonical: string;
  menu?: string;
  imagen?: string; // imagen para compartir en redes (ruta absoluta del sitio)
  ogTitulo?: string;
  ogDescripcion?: string;
  jsonld?: string; // datos estructurados (JSON-LD) ya serializados
}
const { title, description = '', canonical, menu, imagen, ogTitulo, ogDescripcion, jsonld } = Astro.props as Props;
const dominio = site.dominio ? `https://${site.dominio}` : '';
const imagenAbsoluta = imagen ? (imagen.startsWith('http') ? imagen : `${dominio}${imagen}`) : '';
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-192.png" type="image/png" sizes="192x192" />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="noindex, nofollow" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content={site.nombre} />
    <meta property="og:title" content={ogTitulo || title} />
    {(ogDescripcion || description) && <meta property="og:description" content={ogDescripcion || description} />}
    <meta property="og:url" content={canonical} />
    {imagenAbsoluta && <meta property="og:image" content={imagenAbsoluta} />}
    {jsonld && <script type="application/ld+json" set:html={jsonld} />}
    <meta name="twitter:card" content={imagenAbsoluta ? 'summary_large_image' : 'summary'} />
    <!-- noindex provisional: se quita en la Fase 7, el día del cambio de DNS -->
  </head>
  <body>
    <Header menu={menu} />
    <slot />
    <Footer menu={menu} />
  </body>
</html>
